{
  // Line length: reference docs have intentionally long code lines
  "MD013": false,
  // Inline HTML: some docs use HTML for formatting
  "MD033": false,
  // First line H1: SKILL.md files start with YAML frontmatter
  "MD041": false,
  // Hard tabs: present in existing content, not worth reformatting pre-review
  "MD010": false,
  // Multiple blank lines: existing docs use double-blanks for visual separation
  "MD012": false,
  // Blanks around headings: existing style uses compact heading/content spacing
  "MD022": false,
  // Blanks around fenced code blocks: existing style is compact
  "MD031": false,
  // Blanks around lists: existing docs use compact list spacing
  "MD032": false,
  // Bare URLs: reference docs intentionally include full URLs for copy-paste
  "MD034": false,
  // Ordered list prefix: existing docs use incremental numbering (1, 2, 3)
  "MD029": false,
  // Table column style: existing tables use mixed alignment
  "MD060": false
}
